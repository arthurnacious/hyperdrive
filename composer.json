{
    "name": "hyperdrive/framework",
    "description": "Hyperdrive - PHP Framework inspired by NestJS with OpenSwoole",
    "version": "0.0.1",
    "type": "library",
    "require": {
        "symfony/console": "^6.0 || ^7.0 || ^8.0",
        "php": ">=8.4"
    },
    "scripts": {
        "test": "./vendor/bin/pest tests/*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "openswoole/ide-helper": "~22.0.1",
        "swoole/ide-helper": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Hyperdrive\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
